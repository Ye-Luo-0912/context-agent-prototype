/target
# Runtime state dirs appear wherever a crate/test runs (workspace root or
# a crate's own CWD); ignore every level, not just the repository root.
**/.focus-agent/
*.db
*.db-shm
*.db-wal

# Local live-eval secrets (copy from eval.env.example).
eval.env
.env
.env.local
dist/

# .NET build artifacts
clients/dotnet/**/bin/
clients/dotnet/**/obj/
apps/**/bin/
apps/**/obj/
*.user

# IDE
.idea/
/target-host
