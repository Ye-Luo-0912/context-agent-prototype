<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>FocusAgent.Client.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Client\Agent.Client.csproj" />
    <!-- The desktop workbench view model's lifecycle drills (N4/F13) run in
         this suite too: one place, one runner, both assemblies covered. -->
    <ProjectReference Include="..\..\..\apps\Agent.Desktop\Agent.Desktop.csproj" />
  </ItemGroup>

  <!-- The C0 shared contract fixtures live with the Rust protocol crate;
       both language test suites decode and re-encode the same physical
       files, which is the cross-language meaning-consistency check. -->
  <ItemGroup>
    <Content Include="..\..\..\crates\agent-platform-protocol\tests\fixtures\work\**\*.json"
             Link="Fixtures\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
