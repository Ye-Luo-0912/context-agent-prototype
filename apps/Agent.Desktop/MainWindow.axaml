<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FocusAgent.Desktop.ViewModels"
        x:Class="FocusAgent.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Focus Agent 工作台"
        Width="1180" Height="760"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*">

    <!-- 连接栏 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <ComboBox ItemsSource="{Binding Transports}" SelectedIndex="{Binding TransportIndex}" MinWidth="190" />
      <TextBox Text="{Binding Endpoint}" MinWidth="260" />
      <Button Content="连接" Command="{Binding ConnectCommand}" />
      <Button Content="断开" Command="{Binding DisconnectCommand}" />
      <CheckBox Content="自动刷新" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding ConnectionLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
    </StackPanel>

    <!-- G2 状态横幅：重连/resync/夹具提示，绝不静默 -->
    <Border Grid.Row="1" Background="#22d0a000" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
            IsVisible="{Binding BannerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" />
    </Border>

    <!-- 主体：左任务列表 / 右工作区 -->
    <Grid Grid.Row="2" ColumnDefinitions="340,*">

      <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="0,0,10,0">
        <Border Grid.Row="0" BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="任务" FontWeight="Bold" Margin="0,0,0,6" />
            <!-- ListBox 自带虚拟化：只实例化视口内的行（G3）。选中行触发
                 B3 任务详情只读加载（C3），选择本身不提交/不继续。 -->
            <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskItemViewModel">
                  <StackPanel Margin="2">
                    <TextBlock Text="{Binding Goal}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusLine}" Foreground="#99808080" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Context（只读）" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="刷新" Command="{Binding RefreshContextCommand}" Padding="8,2" />
              </StackPanel>
              <!-- C3/B3 诚实状态行：未读取/失败时明确显示，不显示推断内容 -->
              <TextBlock Text="{Binding ContextStatusText}" TextWrapping="Wrap" Foreground="#99808080" FontSize="11" />
            </StackPanel>
            <!-- C3/B3：真实条目列表（有界）；每行只显示摘要自身的类型化字段 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ContextItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContextItemRowViewModel">
                    <StackPanel Margin="0,2">
                      <TextBlock Text="{Binding Line}" TextWrapping="Wrap" FontSize="11" Foreground="#bb808080" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- 输入区 -->
        <TextBox Grid.Row="0" Text="{Binding GoalInput}" Watermark="描述一个新的工作目标（提交后原子建立任务并排队首轮输入）…"
                 AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Margin="0,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="提交新工作" Command="{Binding SubmitCommand}" />
            <Button Content="继续活动任务" Command="{Binding ContinueCommand}" />
            <Button Content="取消当前轮" Command="{Binding CancelCommand}" />
            <Button Content="刷新快照" Command="{Binding RefreshCommand}" />
          </StackPanel>
          <TextBlock Text="「继续」沿活动任务当前指令继续；新目标永远是新任务。取消以服务端确认为准。"
                     FontSize="11" Foreground="#99808080" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 待审批 -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,4">
          <TextBlock Text="待审批（服务端绑定，等待真实回执）" FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding Approvals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ApprovalItemViewModel">
                <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,2">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding RiskLine}" FontSize="11" Foreground="#cc9a5a00" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding TargetLine}" FontSize="11" Foreground="#99808080" TextWrapping="Wrap" MaxWidth="560" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="允许" Command="{Binding AllowCommand}" />
                      <Button Content="拒绝" Command="{Binding DenyCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- C3 审阅区（B3 只读路由；纯观察，不起模型轮/不改状态） -->
        <TabControl Grid.Row="3" Margin="0,4" MinHeight="150">
          <TabItem Header="任务详情（只读）">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding TaskDetailText}" TextWrapping="Wrap"
                         FontFamily="Consolas,monospace" FontSize="12" />
            </ScrollViewer>
          </TabItem>
          <TabItem Header="变更审阅（只读）">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Text="{Binding ChangesStatusText}" VerticalAlignment="Center"
                           Foreground="#99808080" FontSize="11" />
                <Button Content="刷新变更" Command="{Binding RefreshChangesCommand}" Padding="8,2" />
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Changes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChangeRowViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="#cc9a5a00" />
                        <TextBlock Text="{Binding Line}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas,monospace" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </TabItem>
          <TabItem Header="工件（只读，可分页）">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <!-- 只读观察：引用文本由操作者显式输入，读取结果如实显示 -->
                <TextBox Text="{Binding ArtifactReference}" Watermark="工件引用（reference）…" MinWidth="280" />
                <Button Content="读取" Command="{Binding ReadArtifactCommand}" Padding="8,2" />
                <Button Content="下一页" Command="{Binding NextArtifactPageCommand}" Padding="8,2" />
                <Button Content="读尾部" Command="{Binding ReadArtifactTailCommand}" Padding="8,2" />
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ArtifactText}" TextWrapping="Wrap" FontSize="11"
                           FontFamily="Consolas,monospace" />
              </ScrollViewer>
            </DockPanel>
          </TabItem>
        </TabControl>

        <!-- C2（GUI-2）：输出正文（模型内容）与运行日志（回执/失败/账目）分开呈现 -->
        <TabControl Grid.Row="4" Margin="0,8,0,0">
          <TabItem Header="输出正文">
            <TextBox Text="{Binding OutputText}" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas,monospace" />
          </TabItem>
          <TabItem Header="运行日志">
            <TextBox Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas,monospace" />
          </TabItem>
        </TabControl>

        <!-- 状态条 -->
        <Border Grid.Row="5" BorderBrush="#33808080" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock><Run Text="watermark: " /><Run Text="{Binding Watermark}" /></TextBlock>
            <TextBlock Text="{Binding FocusText}" TextWrapping="Wrap" MaxWidth="380" />
            <TextBlock Text="{Binding RunStateText}" TextWrapping="Wrap" MaxWidth="300" />
            <TextBlock Text="{Binding CancelStateText}" TextWrapping="Wrap" MaxWidth="320" />
            <TextBlock Text="{Binding PlanText}" Foreground="#99808080" TextWrapping="Wrap" MaxWidth="320" />
            <TextBlock Text="{Binding CostSummaryText}" Foreground="#99808080" TextWrapping="Wrap" MaxWidth="420" />
            <!-- C4：实测/估算/未知三分账目；未知轮计数可见，不折算成零 -->
            <TextBlock Text="{Binding CostSummaryText}" Foreground="#99808080" TextWrapping="Wrap" MaxWidth="520" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="#99808080"
               Text="C0 会话契约 · 受理 ≠ 应用 ≠ 任务完成 ≠ 清理确认；审批等待服务端回执，不本地宣布授权。" />
  </Grid>
</Window>
