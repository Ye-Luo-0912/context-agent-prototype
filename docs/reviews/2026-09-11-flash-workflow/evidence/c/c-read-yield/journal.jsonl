,\n    27 |         \"unicode\": (\"[ok](中文.md)\", []),\n    28 |         \"mixed\": (\"[ok](exists.md) [bad](missing.md) [web](https://example.test)\", [\"docs/index.md: broken link -> missing.md\"]),\n    29 |     }[domain]\n    30 |     if domain == \"nested\":\n    31 |         page = \"docs/sub/index.md\"\n    32 |     if domain != \"missing_document\":\n    33 |         (tmp_path / page).write_text(body, encoding=\"utf-8\")\n    34 |     checker.ROOT = str(tmp_path)\n    35 |     checker.LIVE_DOCS = [page]\n    36 |     actual = []\n    37 |     checker.check_links(actual)\n    38 |     assert actual == expected","metadata":{"bytes":1790,"covers_file":true,"end_line":38,"fs_read_motive":"first","line_count":38,"line_ending":"crlf","path":"tests/test_links.py","revision":"ff4545a90f3f3e1068bda72ba11681ba2dd941d163696d9507efb1e565b06779","start_line":1}},"facts":null}}
