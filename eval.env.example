# Copy to eval.env (gitignored) and fill OPENAI_API_KEY.
# Do not commit eval.env. Do not paste the key into chat.
# Evidence bundles store MODEL / BASE_URL only, never the key.
#
# The live client uses Windows system proxy (Internet Settings) plus
# HTTP_PROXY/HTTPS_PROXY/ALL_PROXY. A local Clash mixed port with
# "system proxy" enabled is enough; do not paste the key into chat.
# If system proxy is off, export HTTPS_PROXY=http://127.0.0.1:<mixed-port>
# in the process environment before agent-eval.
#
# Last diagnostic used a tool-capable OpenAI-compatible gateway:

OPENAI_BASE_URL=https://api.pinaic.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
