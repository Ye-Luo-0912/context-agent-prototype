{"run_id":"305a705b-0c42-443b-8851-8c7a7ec10f77","seq":20,"timestamp_ms":1787879849041,"event":{"type":"tool_finished","output":{"call_id":"call_01_TvO5noiuN6y6M7YW7Pwp6184","tool_name":"fs.read","ok":true,"summary":"read lines 1-35 of src/lib.rs","model_content":"file=\"src/lib.rs\" revision=bca85bcde82fa327c8e30b863f7069208962a328a0b09d5abaa0ab9290c381bb line_ending=lf\n     1 | //! Monolithic job runner: retry policy still lives in the crate root.\n     2 | pub mod job;\n     3 | pub mod metrics;\n     4 | pub mod usage;\n     5 | \n     6 | /// Retry policy for one job: attempts and the delay table.\n     7 | #[derive(Debug, Clone, PartialEq, Eq)]\n     8 | pub struct RetryPolicy {\n     9 |     pub max_attempts: u32,\n    10 |     pub base_delay_ms: u64,\n    11 | }\n    12 | \n    13 | /// How the delay grows between attempts.\n    14 | #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    15 | pub enum Backoff {\n    16 |     Fixed,\n    17 |     Double,\n    18 | }\n    19 | \n    20 | impl RetryPolicy {\n    21 |     pub fn new(max_attempts: u32, base_delay_ms: u64) -> Self {\n    22 |         Self { max_attempts, base_delay_ms }\n    23 |     }\n    24 | \n    25 |     pub fn delay_before(&self, attempt: u32, backoff: Backoff) -> u64 {\n    26 |         match backoff {\n    27 |             Backoff::Fixed => self.base_delay_ms,\n    28 |             Backoff::Double => self.base_delay_ms.saturating_mul(attempt.max(1) as u64),\n    29 |         }\n    30 |     }\n    31 | }\n    32 | \n    33 | pub fn max_attempts(policy: &RetryPolicy) -> u32 {\n    34 |     policy.max_attempts\n    35 | }","metadata":{"bytes":897,"fs_read_motive":"first","line_count":35,"line_ending":"lf","path":"src/lib.rs","revision":"bca85bcde82fa327c8e30b863f7069208962a328a0b09d5abaa0ab9290c381bb"}}}}
