{"run_id":"8ade69e0-fd31-45ef-b9ba-f05ac9aabf2e","seq":48,"timestamp_ms":1786715742397,"event":{"type":"tool_started","call":{"id":"call_CS3sFaiJrIN6lFvZD1C88g4q","name":"shell.exec","arguments":{"command":"python - <<'PY'\nfrom batched import batched\n\nassert list(batched(range(7), 3)) == [[0, 1, 2], [3, 4, 5], [6]]\nassert list(batched([], 3)) == []\nfor n in (0, -1):\n    try:\n        batched([], n)\n    except ValueError as exc:\n        assert str(exc) == 'n must be at least one'\n    else:\n        raise AssertionError(n)\n\nclass Tracked:\n    def __init__(self):\n        self.consumed = 0\n    def __iter__(self):\n        while self.consumed < 5:\n            self.consumed += 1\n            yield self.consumed\n\nsource = Tracked()\nresult = batched(source, 2)\nassert source.consumed == 0\nassert next(result) == [1, 2]\nassert source.consumed == 2\nassert next(result) == [3, 4]\nassert source.consumed == 4\nassert next(result) == [5]\nassert source.consumed == 5\nprint('ok')\nPY"}}}}
