{"run_id":"8ade69e0-fd31-45ef-b9ba-f05ac9aabf2e","seq":38,"timestamp_ms":1786715732688,"event":{"type":"tool_started","call":{"id":"call_fgvAI7AkMEfiD09DCLNiRBz7","name":"edit.replace","arguments":{"new":"def batched(iterable, n):\n    if n < 1:\n        raise ValueError(\"n must be at least one\")\n\n    def batches():\n        iterator = iter(iterable)\n        while True:\n            batch = []\n            try:\n                for _ in range(n):\n                    batch.append(next(iterator))\n            except StopIteration:\n                if batch:\n                    yield batch\n                return\n            yield batch\n\n    return batches()\n","old":"def batched(iterable, n):\n    if n < 1:\n        raise ValueError(\"n must be at least one\")\n    return [list(iterable)]\n","path":"batched.py"}}}}
