{"run_id":"158503ec-b1ca-4847-9de0-eb9104593f4f","seq":57,"timestamp_ms":1786716049593,"event":{"type":"tool_started","call":{"id":"call_jXCsvcC3rODmKrltWgpWeFbu","name":"shell.exec","arguments":{"command":"python - <<'PY'\nfrom batched import batched\n\nassert list(batched(range(5), 2)) == [[0, 1], [2, 3], [4]]\nassert list(batched([], 3)) == []\nfor n in (0, -1):\n    try:\n        batched([], n)\n    except ValueError as exc:\n        assert str(exc) == 'n must be at least one'\n    else:\n        raise AssertionError(n)\n\nseen = []\ndef source():\n    for value in range(3):\n        seen.append(value)\n        yield value\nresult = batched(source(), 2)\nassert seen == []\nassert next(result) == [0, 1]\nassert seen == [0, 1]\nassert next(result) == [2]\nassert seen == [0, 1, 2]\nprint('ok')\nPY"}}}}
