* text=auto eol=lf

# evidence package must stay byte-exact (hash manifest integrity)
docs/experiments/runtime-endurance-v1/evidence/** -text
# archived external reviews carry their own sha256 list; a checkout must not
# renormalize them (the delivered files are already LF, so this only protects
# future ingestions from silently invalidating a manifest)
docs/reviews/**/REVIEW.md -text
docs/reviews/**/audit_manifest.json -text
docs/reviews/**/probe_results_baseline.json -text
docs/reviews/**/probe_stdout_baseline.log -text
docs/reviews/**/sources/** -text
docs/reviews/**/probes/** -text

# Terminal-Bench identities include byte digests of grant candidates and
# frozen receipts. Preserve the delivered bytes on every checkout.
docs/experiments/terminal-bench-pilot/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/terminal_bench_pilot/grants_*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
